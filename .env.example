# LiteLLM API Key Pool (at least 2 keys, comma-separated)
# key_1 corresponds to the first key, key_2 to the second, etc.
LLM_API_KEYS=your-first-api-key-here,your-second-api-key-here

# Target Model Identifier (LiteLLM supported model string)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database Location
# In Docker: sqlite:////data/app.db (persisted on /data volume)
# Locally: sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Failover Test Hook Switch (must be true on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Frontend API base URL (used during build/runtime)
VITE_API_BASE_URL=http://localhost:8000
